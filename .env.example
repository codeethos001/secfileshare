# Server & Environment Configuration
PROJECT_NAME="SecureShare"
ENVIRONMENT="development"
DEBUG=true
API_V1_STR="/api/v1"
SECRET_KEY="replace-this-with-a-secure-random-secret-key-in-production"

# Database Configuration
# Default to SQLite for easy local dev, or set to MariaDB:
# DATABASE_URL="mysql+pymysql://secureshare_user:secureshare_password@mariadb:3306/secureshare"
DATABASE_URL="sqlite:///./secureshare.db"

# MariaDB Specific (used by docker-compose)
MARIADB_DATABASE=secureshare
MARIADB_USER=secureshare_user
MARIADB_PASSWORD=secureshare_password
MARIADB_ROOT_PASSWORD=secureshare_root_secret
MARIADB_PORT=3306

# Storage Configuration
STORAGE_DIR="./storage"
MAX_UPLOAD_SIZE_BYTES=104857600  # 100 MB max file upload
CHUNK_SIZE_BYTES=4194304         # 4 MB chunk size

# Security & CORS
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"
SESSION_EXPIRE_HOURS=24
DOWNLOAD_SESSION_EXPIRE_MINUTES=60
